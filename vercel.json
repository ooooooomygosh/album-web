{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "fluid": true,
  "functions": {
    "api/ai.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/ai/:task",
      "destination": "/api/ai?task=:task"
    },
    {
      "source": "/((?!api/.*|@vite/.*|@react-refresh|src/.*|node_modules/.*|assets/.*|fonts/.*|room-scenes/.*|licenses/.*|wallpaper.html|icon.svg|manifest.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
