{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/ai/background.js": {
      "maxDuration": 60
    },
    "api/ai/comment.js": {
      "maxDuration": 30
    },
    "api/ai/recommend.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
