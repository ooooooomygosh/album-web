{
  "name": "flow-cabin",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "desktop:dev": "npm --prefix desktop start",
    "desktop:test": "npm --prefix desktop test",
    "desktop:dist": "npm --prefix desktop run dist",
    "icons": "node scripts/generate-icons.mjs",
    "test": "npm run desktop:test && node --test src/audio/lifecycle.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "check": "npm test && npm run build",
    "qa": "npm run check && npm --prefix desktop run build:music && npm run test:browser"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tone": "^15.1.22",
    "typescript": "^5.9.3",
    "vite": "^8.1.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "description": "心流小屋 · Flow Cabin — a pixel lo-fi cabin desktop app: favourite albums, a turntable, focus timer, ambience and a desktop cat"
}
